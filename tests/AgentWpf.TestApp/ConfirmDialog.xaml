<Window x:Class="AgentWpf.TestApp.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bestätigung" Width="300" Height="140" WindowStartupLocation="CenterOwner"
        AutomationProperties.AutomationId="ConfirmDialog">
  <StackPanel Margin="10">
    <TextBlock Text="Wirklich fortfahren?" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="OK" AutomationProperties.AutomationId="btnOk" IsDefault="True" Click="OnOk" Width="70" />
      <Button Content="Abbrechen" AutomationProperties.AutomationId="btnCancel" IsCancel="True" Width="70" Margin="6,0,0,0" />
    </StackPanel>
  </StackPanel>
</Window>
